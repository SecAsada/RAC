            local addr20 = candidate_refs[i] + 0x20
            local addr24 = candidate_refs[i] + 0x24
            local addr5C = candidate_refs[i] + 0x5C

            saveOriginal(addr20, gg.TYPE_DWORD)
            saveOriginal(addr24, gg.TYPE_DWORD)
            saveOriginal(addr5C, gg.TYPE_FLOAT)

            edits[#edits + 1] = { address = addr20, flags = gg.TYPE_DWORD, value = 1,     freeze = true }
