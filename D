function saveOriginal(address, flags)
    local key = tostring(address) .. "_" .. tostring(flags)
    if savedValues[key] == nil then
        local v = gg.getValues({{ address = address, flags = flags }})
        if v and v[1] then
            savedValues[key] = {
                address = address,
                flags   = flags,
                value   = v[1].value
            }
        end
    end
end



