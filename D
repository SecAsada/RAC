function classValue(Name, Offset, Type)
  gg.setVisible(false)
  local offForField = 0x8
  if gg.getTargetInfo().x64 then offForField = 0x10 end 
  local metadata = gg.getRangesList('global-metadata.dat')
  gg.clearResults()
  gg.setRanges(-1)
  gg.searchNumber(':'..Name, 4, false, gg.SIGN_EQUAL, metadata[1].start, metadata[1]['end'])
  local vr = gg.getResults(gg.getResultsCount())
  local count = #vr/#Name
  local t={}
  for i=1, count do
    table.insert(t, vr[(i*#Name)-(#Name-1)])
  end
  gg.loadResults(t)
  gg.setRanges(32)
  gg.searchPointer(0)
  local vr = gg.getResults(gg.getResultsCount())
  for i, v in ipairs(vr) do
    v.address = v.address-offForField
  end
  gg.setRanges(32)
  gg.loadResults(vr)
  gg.searchPointer(0)
  if Offset and Offset~=0 then
    local vr = gg.getResults(gg.getResultsCount())
    for i, v in ipairs(vr) do
      v.address=v.address+Offset
      v.flags=Type
    end
    gg.loadResults(vr)
  end
end





