        gg.toast("Nothing to restore.")
        return
    end

    local restoreItems = {}
    for _, data in pairs(savedValues) do
        restoreItems[#restoreItems + 1] = {
            address = data.address,
            flags   = data.flags,
            value   = data.value
        }
