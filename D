                        end
                    end
                    if #e > 0 then
                        gg.addListItems(e)
                    end
                end
            end
        end
    end

    gg.clearResults()
    Removpenal()
    gg.toast("🏆 Auto Win Active! Hit the target to finish the race.")
end

