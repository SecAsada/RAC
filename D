-- Global saved table (stores original values)
local V7q = {}

-- ---------- Helper functions ----------
local function B9x()
    local ranges = gg.getRangesList("libil2cpp.so")
    if not ranges or #ranges < 2 then
        return nil
    end
    return ranges[2].start
end

-- Save original value before modifying
local function S2k(A, F)
    local current = gg.getValues({{address = A, flags = F}})
    if current and #current > 0 then
        V7q[A] = {
            flags = F,
            value = current[1].value
        }
    end
end

